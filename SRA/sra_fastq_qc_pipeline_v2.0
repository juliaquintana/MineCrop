#!/bin/bash
# Description: Download FASTQ files from SRA and run QC with FastQC
# Author: Julia Quintana
# Date: 2026-08-24

set -euo pipefail

# Set paths
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SRA_LIST="./SRR_Acc_List.txt"
RAW_DIR="/tmp/sra_raw"
QC_DIR="./qc_reports"

# Create output directories
mkdir -p "$RAW_DIR" "$QC_DIR"

# Loop through each accession number
while IFS= read -r accession || [[ -n "$accession" ]]; do

    # Remove leading/trailing spaces and Windows line endings
    accession=$(printf '%s' "$accession" | tr -d '\r' | xargs)

    # Skip empty lines
    [[ -z "$accession" ]] && continue

    echo "🔽 Downloading $accession..."

    if prefetch "$accession"; then

        fasterq-dump \
            "$accession" \
            -O "$RAW_DIR" \
            -t "$RAW_DIR" \
            -e 8

        echo "🔬 Running FastQC for $accession..."

        fastqc \
            -t 8 \
            -o "$QC_DIR" \
            "$RAW_DIR/${accession}_1.fastq" \
            "$RAW_DIR/${accession}_2.fastq"

        echo "☁️ Uploading FastQC reports to Google Cloud..."

        gsutil -m cp \
            "$QC_DIR/${accession}_1_fastqc.html" \
            "$QC_DIR/${accession}_2_fastqc.html" \
            gs://your-bucket-name

        echo "🧹 Cleaning up..."

        cache-mgr --clear

        rm -f \
            "$RAW_DIR/${accession}_1.fastq" \
            "$RAW_DIR/${accession}_2.fastq"

    else

        echo "❌ Failed to prefetch $accession"

    fi

    echo "✅ Done with $accession"

done < "$SRA_LIST"

echo "📊 Generating MultiQC report..."

multiqc "$QC_DIR" \
    --outdir "$QC_DIR/multiqc"

echo "☁️ Uploading MultiQC report..."

gsutil cp \
    "$QC_DIR/multiqc/multiqc_report.html" \
    gs://your-bucket-name

gsutil -m cp -r \
    "$QC_DIR/multiqc/multiqc_data" \
    gs://your-bucket-name

echo "🎉 QC analysis complete!"

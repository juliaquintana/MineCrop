#!/bin/bash
# =============================================================================
# Download SRA accessions, run FastQC, summarize with MultiQC,
# and upload QC reports to Google Cloud Storage.
# Author: Julia Quintana
# Date: 2026-08-24
# =============================================================================

set -euo pipefail

# -------------------------
# User settings
# -------------------------

# File containing one SRA accession per line
SRA_LIST="/path/to/SRR_Acc_List.txt"

# Temporary directory for FASTQ files
RAW_DIR="/tmp/sra_raw"

# Directory for QC results
QC_DIR="./qc_reports"

# Google Cloud bucket
GCS_BUCKET="gs://your-bucket-name"

# Thread settings
DUMP_THREADS=8
FASTQC_THREADS=4

# -------------------------
# Create directories
# -------------------------

mkdir -p "$RAW_DIR"
mkdir -p "$QC_DIR"

echo "🚀 Starting SRA QC pipeline"
echo "📄 Accession list: $SRA_LIST"
echo "📁 QC directory: $QC_DIR"

# -------------------------
# Process accessions
# -------------------------

while IFS= read -r accession || [[ -n "$accession" ]]; do

    # Remove whitespace and Windows line endings
    accession=$(printf '%s' "$accession" | tr -d '\r' | xargs)

    # Skip empty lines
    [[ -z "$accession" ]] && continue

    echo ""
    echo "════════════════════════════════════════"
    echo "🔽 Downloading $accession"
    echo "════════════════════════════════════════"

    if prefetch "$accession"; then

        echo "📦 Converting SRA to FASTQ..."

        fasterq-dump \
            "$accession" \
            -O "$RAW_DIR" \
            -t "$RAW_DIR" \
            -e "$DUMP_THREADS"

        echo "🔬 Running FastQC..."

        # Paired-end
        if [[ -f "$RAW_DIR/${accession}_2.fastq" ]]; then

            fastqc \
                -t "$FASTQC_THREADS" \
                -o "$QC_DIR" \
                "$RAW_DIR/${accession}_1.fastq" \
                "$RAW_DIR/${accession}_2.fastq"

        # Single-end
        else

            fastqc \
                -t "$FASTQC_THREADS" \
                -o "$QC_DIR" \
                "$RAW_DIR/${accession}.fastq"

        fi

        echo "🧹 Removing temporary FASTQ files..."

        rm -f "$RAW_DIR/${accession}"*.fastq

        echo "✅ Completed $accession"

    else

        echo "❌ Failed to download $accession"

    fi

done < "$SRA_LIST"

# -------------------------
# Clear cache once
# -------------------------

echo ""
echo "🗑️ Clearing SRA cache..."

cache-mgr --clear

# -------------------------
# Generate MultiQC report
# -------------------------

echo ""
echo "📊 Generating MultiQC report..."

multiqc \
    "$QC_DIR" \
    --outdir "$QC_DIR/multiqc"

# -------------------------
# Upload results
# -------------------------

echo ""
echo "☁️ Uploading MultiQC results..."

gsutil cp \
    "$QC_DIR/multiqc/multiqc_report.html" \
    "$GCS_BUCKET/"

gsutil -m cp -r \
    "$QC_DIR/multiqc/multiqc_data" \
    "$GCS_BUCKET/"

echo ""
echo "🎉 QC pipeline completed successfully!"
echo "📈 MultiQC report uploaded to:"
echo "☁️ $GCS_BUCKET"
